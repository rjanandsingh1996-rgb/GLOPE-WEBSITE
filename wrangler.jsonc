{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "glope-website",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/admin*", "/api/admin/*"]
  },
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "glope-sales-v1-preview",
        "database_id": "2a8be24e-5a0e-4c4e-b797-379e41a39304",
        "migrations_dir": "migrations"
      }
    ]
  }
}
